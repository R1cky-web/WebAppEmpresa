@model WebAppEmpresa.Models.Operaciones

@{
    ViewData["Title"] = "Create";
}

<div class="card card-info card-outline mb-4">
    <div class="card">
        <div class="card-header">
            <i data-lte-icon="collapse" class="bi bi-pencil-square"></i>
            Registrar Operacion
            <div class="card-tools">
        </div>
        <button type="button" class="btn btn-tool" data-lte-toogle="card-collapse">
            <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
            <i data-lte-icon="collapse" class=" bi bi-dash-lg"></i>
        </button>
        <button type="button"class="btn btn-tool dropdown-toggle"data-bs-toggle="dropdown">
                <i class="bi bi-wrench"></i>
        </button>
    </div>
    <div class="card-body">
        
                <form asp-action="Create">
                <div class="row">
                    <div class="col-md-6">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label>Responsable</label>
                        <input asp-for="Responsable" class="form-control" />
                        <div class="form-group">
                            <label>Estado</label>
                        <input asp-for="Estado" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label"></label>
                        <input asp-for="Descripcion" class="form-control" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Cantidad" class="control-label"></label>
                        <input asp-for="Cantidad" class="form-control" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>
                    </div>
                    <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Importe" class="control-label"></label>
                        <input asp-for="Importe" class="form-control" />
                        <span asp-validation-for="Importe" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Igv" class="control-label"></label>
                        <input asp-for="Igv" class="form-control" />
                        <span asp-validation-for="Igv" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="total" class="control-label"></label>
                        <input asp-for="total" class="form-control" />
                        <span asp-validation-for="total" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                       
                    </div>
                    
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                    </div>
                </div>
                </form>
            
        </div>

       
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
