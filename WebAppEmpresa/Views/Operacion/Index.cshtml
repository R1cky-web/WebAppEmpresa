@model IEnumerable<WebAppEmpresa.Models.Operacion>
@*<h1>Listado de Operaciones</h1>
<br>*@
<div class="card card-primary card-outline mb-4">
	<div class="card">
		<div class="card-header">
			<i data-lte-icon="collapse" class="bi bi-list"></i>
			Listado de las operaciones
			<div class="card-tools">
				<button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
					<i data-lte-icon="expand" class="bi bi-plus-lg"> </i>
					<i data-lte-icon="collapse" class="bi bi-dash-lg"> </i>
				</button>
				<button type="button" class="btn btn-tool dropdown-toggle" data-bs-toggle="dropdown">
					<i class="bi bi-wrench"></i>
				</button>
			</div>
		</div>
		<div class="card-header">
			<a class="btn btn-success btn-sm text-white" role="button">
				<i class="bi bi-plus-square"></i>
			</a>
		</div>
		<div class="card-body">


			<table class="table table-bordered table-hover">
				<thead>
					<tr class="table-info">
						<th><center><strong>Id</strong></center></th>
						<th><center><strong>Descripcion</strong></center></th>
						<th><center><strong>Cantidad</strong></center></th>
						<th><center><strong>Importe</strong></center></th>
						<th><center><strong>Igv</strong></center></th>
						<th><center><strong>Total</strong></center></th>
						<th><center><strong>Responsable</strong></center></th>
						<th><center><strong>Estado</strong></center></th>
						<th><center><strong>Registro</strong></center></th>
						<th><center><strong>Opciones</strong></center></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td align="center">@item.idOperacion</td>
							<td align="left">@item.Descripcion</td>
							<td align="center">@item.Cantidad</td>
							<td align="center">@item.Importe</td>
							<td align="center">@item.Igv</td>
							<td align="center">@item.total</td>
							<td align="center">@item.Responsable</td>
							<td align="center">@item.Estado</td>
							<td align="center">@item.registro</td>
							<td align="center">
								<a class="btn btn-info btn-sm text-white" role="button">
									<i class="bi bi-pencil-square"></i>
								</a>
								<a class="btn btn-warning btn-sm text-white" role="button">
									<i class="bi bi-eye-fill"></i>
								</a>
								<a class="btn btn-danger btn-sm text-white" role="button">
									<i class="bi bi-trash3-fill"></i>
								</a>

							</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="card-footer" >
				Listado de operaciones de la empresa
				<a href="a"
				target="_blank"
				class="link-primary">Bootstrap Backbround Colors</a>	
			</div>
		</div>
	</div>
</div>


